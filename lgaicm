#!/usr/bin/env bash
set -euo pipefail

DEBUG_LOG="${LGAICM_DEBUG_LOG:-/tmp/lgaicm_debug.log}"

readonly ALLOWED_TYPES=(feat fix chore docs style refactor perf test ci build)

die() {
  echo "Error: $*" >&2
  exit 1
}

log_debug() {
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  printf '[%s] %s\n' "$timestamp" "$*" >> "$DEBUG_LOG"
}

log_debug_multiline() {
  local label="$1"
  local content="$2"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  {
    printf '\n========================================\n'
    printf '[%s] %s\n' "$timestamp" "$label"
    printf '========================================\n'
    printf '%s\n' "$content"
    printf '========================================\n\n'
  } >> "$DEBUG_LOG"
}

usage() {
  cat <<EOF
lgaicm - AI-powered conventional commit suggestions (multi-line safe)

Usage:
  lgaicm suggest --type <type>
  lgaicm commit  --file <path>

Subcommands:

  suggest
    Generates commit message suggestions from staged changes and prints lines:
      <subject> <===> <path-to-message-file>

    Options:
      -t, --type <type>    Required. One of: ${ALLOWED_TYPES[*]}

  commit
    Creates the commit using the selected message file (multi-line),
    then cleans up the temp suggestion directory (when safe).

    Options:
      -f, --file <path>    Required. Path returned by the 'suggest' command.

Environment:
  GOOGLEAI_API_KEY                Required.
  LGAICM_MODEL                    Default: gemini-3.5-flash-lite
  LGAICM_API_URL                  Default:
                                  https://aiplatform.googleapis.com/v1/publishers/google/models
                                  This is treated as the BASE Vertex AI endpoint. lgaicm always
                                  appends "/<model>:generateContent" itself, e.g.:
                                    <LGAICM_API_URL>/<LGAICM_MODEL>:generateContent
                                  For backward compatibility, a literal "{model}" (or "{MODEL}")
                                  placeholder anywhere in LGAICM_API_URL is still supported and
                                  will be substituted with the model id. If LGAICM_API_URL already
                                  contains ":generateContent", it is used as-is (model assumed to
                                  be already baked in).
  LGAICM_CURL_TIMEOUT             Default: 45
  LGAICM_MAX_STAT_BYTES           Default: 60000
  LGAICM_MAX_DIFF_BYTES           Default: 200000
  LGAICM_MIN_SUGGESTIONS          Default: 5
  LGAICM_MAX_SUGGESTIONS          Default: 7
  LGAICM_MAX_SUBJECT_LENGTH       Default: 500
  LGAICM_DEBUG_LOG                Default: /tmp/lgaicm_debug.log
EOF
}

require_command() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "Required command '$cmd' is not available in PATH."
  done
}

parse_positive_int() {
  local value="${1:-}"
  local fallback="${2:-}"
  if [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 )); then
    printf '%s' "$value"
  else
    printf '%s' "$fallback"
  fi
}

truncate_bytes() {
  local text="$1"
  local limit="$2"
  local length
  length="$(LC_ALL=C printf '%s' "$text" | wc -c | awk '{print $1}')"
  if (( length <= limit )); then
    printf '%s' "$text"
  else
    printf '%s' "$text" | head -c "$limit"
    printf '\n\n[Truncated to %s bytes]\n' "$limit"
  fi
}

in_allowed_types() {
  local candidate="$1" allowed
  for allowed in "${ALLOWED_TYPES[@]}"; do
    [[ "$candidate" == "$allowed" ]] && return 0
  done
  return 1
}

git_require_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not inside a git repository."
}

git_require_staged_changes() {
  if git diff --cached --quiet; then
    die "No staged changes detected. Stage files before generating commit messages."
  fi
}

generate_content_extract_text() {
  # Prefer real answer text (parts without "thought" set). Some models
  # omit the "thought" field entirely, so fall back to every text part
  # found if the strict filter above yields nothing.
  jq -r '
    [.candidates[0]?.content?.parts[]? | select(.text? != null and (.thought? != true)) | .text] as $primary
    | if ($primary | length) > 0
      then $primary | join("")
      else [.candidates[0]?.content?.parts[]? | select(.text? != null) | .text] | join("")
      end
  '
}

build_generate_content_url() {
  local api_url="$1" model="$2" api_key="$3"
  local endpoint encoded_api_key separator

  [[ -n "$model" ]] || die "LGAICM_MODEL must not be empty."
  [[ -n "$api_url" ]] || die "LGAICM_API_URL must not be empty."

  # Backward-compatible templating: substitute a "{model}"/"{MODEL}"
  # placeholder anywhere in the URL with the configured model id.
  endpoint="${api_url//\{model\}/$model}"
  endpoint="${endpoint//\{MODEL\}/$model}"

  [[ "$endpoint" != *"{model}"* && "$endpoint" != *"{MODEL}"* ]] || die \
    "LGAICM_API_URL contains an unresolved {model} placeholder."

  # No placeholder was used: treat LGAICM_API_URL as the BASE Vertex AI
  # "publishers/google/models" URL and append the model + method,
  # unless it is already a fully qualified generateContent endpoint.
  if [[ "$endpoint" == "$api_url" && "$endpoint" != *":generateContent"* ]]; then
    endpoint="${endpoint%/}/${model}:generateContent"
  fi

  [[ "$endpoint" == *":generateContent"* ]] || die \
    "LGAICM_API_URL must target a Vertex AI generateContent endpoint."

  log_debug "Resolved generateContent endpoint (no key): $endpoint"

  encoded_api_key="$(jq -nr --arg value "$api_key" '$value | @uri')"
  separator="?"
  [[ "$endpoint" == *"?"* ]] && separator="&"

  printf '%s%skey=%s' "$endpoint" "$separator" "$encoded_api_key"
}

normalize_subject() {
  local type="$1"
  local subject="$2"
  local maxlen="$3"

  subject="$(printf '%s' "$subject" | tr -d '\r' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

  local prefix_pattern="^[a-z]+(\([^)]*\))?:[[:space:]]"

  if [[ "$subject" =~ $prefix_pattern ]]; then
    subject="$(printf '%s' "$subject" | sed -E "s/^[a-z]+(\([^)]*\))?:/${type}\1:/")"
  else
    subject="${type}: ${subject}"
  fi

  subject="$(printf '%s' "$subject" | sed -E 's/\.[[:space:]]*$//')"

  subject="$(LC_ALL=C printf '%s' "$subject" | head -c "$maxlen")"
  subject="$(printf '%s' "$subject" | sed -E 's/[[:space:]]+$//')"

  printf '%s' "$subject"
}

build_prompt() {
  local type="$1"
  local min="$2"
  local max="$3"
  local max_subject_len="$4"
  local diff_stat="$5"
  local diff_patch="$6"

  printf 'Generate between %s and %s distinct conventional commit message suggestions.\n\n' "$min" "$max"

  printf 'Rules:\n'
  printf -- '- Use the conventional commit type: "%s" (exactly).\n' "$type"
  printf -- '- Subject format: %s(scope): description\n' "$type"
  printf -- '  - scope is optional but preferred when it can be inferred.\n'
  printf -- '  - imperative mood\n'
  printf -- '  - no trailing period\n'
  printf -- '  - max %s characters\n' "$max_subject_len"
  printf -- '- Body:\n'
  printf -- '  - explain what changed and why\n'
  printf -- '  - if multiple change topics or multiple scope changes, tell about all of them (do not try to pick one)\n'
  printf -- '  - include notable behavior changes\n'
  printf -- '  - include notable risks\n'
  printf -- '  - include things to test to avoid regression\n'
  printf -- '  - wrap text at ~72 characters\n'
  printf -- '  - include code snippets if needed, but indent 4 spaces to make the difference from simple text\n'
  printf -- '  - can be multiple paragraphs, be verbose (plain text)\n\n'

  printf 'Return a valid JSON array in this exact shape:\n'
  printf '[{ "subject": "…", "body": "…" }, ...]\n\n'

  printf 'Staged diff summary:\n%s\n\n' "$diff_stat"
  printf 'Full staged diff:\n%s\n' "$diff_patch"
}

call_gemini_api() {
  local api_url="$1" model="$2" timeout="$3" prompt="$4"

  local system_instructions
  system_instructions=$'You are an expert release engineer.\nReturn ONLY valid JSON. No markdown (no triple backticks). No commentary. No surrounding text.\nAgain, RETURN ONLY a VALID RAW JSON array without surrounding text or explanations.\n'

  log_debug_multiline "SYSTEM INSTRUCTIONS" "$system_instructions"
  log_debug_multiline "USER PROMPT" "$prompt"

  local payload
  payload="$(jq -n \
    --arg instructions "$system_instructions" \
    --arg input "$prompt" \
    '{
      systemInstruction: {
        parts: [
          { text: $instructions }
        ]
      },
      contents: [
        {
          role: "user",
          parts: [
            { text: $input }
          ]
        }
      ],
      generationConfig: {
        responseMimeType: "application/json"
      }
    }')"

  log_debug_multiline "REQUEST PAYLOAD (JSON)" "$payload"

  local url
  url="$(build_generate_content_url "$api_url" "$model" "$GOOGLEAI_API_KEY")"
  log_debug "GenerateContent endpoint: ${url%%\?*}?key=[REDACTED]"

  local response
  if ! response="$(
    curl -sS \
      -X POST \
      -H "Content-Type: application/json" \
      --max-time "$timeout" \
      "$url" \
      -d "$payload"
  )"; then
    log_debug "CURL FAILED"
    die "Failed to call Gemini generateContent API (network/timeout)."
  fi

  log_debug_multiline "API RESPONSE (RAW)" "$response"

  if ! printf '%s' "$response" | jq -e . >/dev/null 2>&1; then
    log_debug "API RESPONSE IS NOT VALID JSON"
    echo "Raw API response:" >&2
    printf '%s\n' "$response" >&2
    die "Gemini generateContent API returned an invalid JSON response."
  fi

  # Google APIs return API failures as:
  # { "error": { "code": ..., "message": ..., "status": ... } }
  if printf '%s' "$response" | jq -e '.error != null' >/dev/null 2>&1; then
    local emsg
    emsg="$(printf '%s' "$response" | jq -r '.error.message // .error.status // "Unknown API error"')"
    log_debug "API ERROR: $emsg"
    die "Gemini generateContent API error: $emsg"
  fi

  local text
  text="$(printf '%s' "$response" | generate_content_extract_text)"
  log_debug_multiline "EXTRACTED OUTPUT" "$text"

  if [[ -z "${text//[[:space:]]/}" ]]; then
    local finish_reasons prompt_block_reason
    finish_reasons="$(printf '%s' "$response" | jq -r '[.candidates[]?.finishReason // empty] | join(", ")')"
    prompt_block_reason="$(printf '%s' "$response" | jq -r '.promptFeedback.blockReason // empty')"

    log_debug "Candidate finish reasons: $finish_reasons"
    log_debug "Prompt block reason: $prompt_block_reason"

    [[ -n "$prompt_block_reason" ]] && die "Gemini blocked the request. Reason: $prompt_block_reason"
    [[ -n "$finish_reasons" ]] && die "Gemini returned no text output. Candidate finish reason(s): $finish_reasons"
    die "Gemini returned no generated text candidates."
  fi

  printf '%s' "$text"
}

parse_suggestions_json() {
  local raw_output="$1"

  # Strip a markdown code fence if the model wrapped the JSON in one.
  if [[ "$raw_output" =~ ^[[:space:]]*\`\`\` ]]; then
    log_debug "Detected markdown code block, stripping..."
    raw_output="$(printf '%s' "$raw_output" | sed -E '1{/^[[:space:]]*```/d}; ${/^[[:space:]]*```/d}')"
  fi

  local parsed
  if ! parsed="$(printf '%s' "$raw_output" | jq -e '
    if type == "array" then .
    elif type == "object" then (
      .suggestions // .commits // .messages // .data // ([.[] | select(type == "array")][0]) // empty
    )
    else empty
    end
  ' 2>/dev/null)"; then
    log_debug "OUTPUT IS NOT A VALID JSON ARRAY"
    echo "AI output was not a valid JSON array. Raw output:" >&2
    printf '%s\n' "$raw_output" >&2
    exit 1
  fi

  local count
  count="$(printf '%s' "$parsed" | jq 'length')"
  log_debug "Number of suggestions: $count"
  (( count > 0 )) || die "AI returned zero suggestions."

  printf '%s' "$parsed"
}

write_suggestions() {
  local type="$1"
  local max_subject_length="$2"
  local parsed_json="$3"

  local session_dir
  session_dir="$(mktemp -d "${TMPDIR:-/tmp}/lgaicm.XXXXXX")"
  touch "$session_dir/.lgaicm_session"
  log_debug "Session directory: $session_dir"

  local count
  count="$(printf '%s' "$parsed_json" | jq 'length')"

  local i
  for (( i=0; i<count; i++ )); do
    local subject body file
    subject="$(printf '%s' "$parsed_json" | jq -r ".[$i].subject // empty")"
    body="$(printf '%s' "$parsed_json" | jq -r ".[$i].body // empty")"

    log_debug "Processing suggestion $((i + 1)): subject='$subject'"

    subject="$(normalize_subject "$type" "$subject" "$max_subject_length")"
    body="$(printf '%s' "$body" | tr -d '\r' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

    [[ -n "${subject//[[:space:]]/}" ]] || continue

    file="$session_dir/msg-$(printf '%03d' "$((i + 1))").txt"

    {
      printf '%s\n' "$subject"
      printf '\n'
      if [[ -n "${body//[[:space:]]/}" ]]; then
        printf '%s\n' "$body"
      fi
    } > "$file"

    log_debug "Created file: $file"
    printf '%s <===> %s\n' "$subject" "$file"
  done
}

suggest_cmd() {
  local TYPE=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--type) TYPE="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown argument for 'suggest': $1" ;;
    esac
  done

  log_debug "=== Starting suggest command ==="
  log_debug "Type: $TYPE"

  [[ -n "$TYPE" ]] || die "'suggest' requires --type <type>."
  in_allowed_types "$TYPE" || die "Invalid type '$TYPE'. Allowed: ${ALLOWED_TYPES[*]}"

  require_command git curl jq mktemp

  [[ -n "${GOOGLEAI_API_KEY:-}" ]] || die "GOOGLEAI_API_KEY environment variable is not set."

  git_require_repo
  git_require_staged_changes

  local MODEL="${LGAICM_MODEL:-gemini-3.5-flash-lite}"
  local API_URL="${LGAICM_API_URL:-https://aiplatform.googleapis.com/v1/publishers/google/models}"
  local CURL_TIMEOUT
  CURL_TIMEOUT="$(parse_positive_int "${LGAICM_CURL_TIMEOUT:-}" 45)"

  log_debug "Model: $MODEL"
  log_debug "API URL (base or template): $API_URL"
  log_debug "Timeout: $CURL_TIMEOUT"

  local MAX_STAT_BYTES
  MAX_STAT_BYTES="$(parse_positive_int "${LGAICM_MAX_STAT_BYTES:-}" 60000)"
  local MAX_DIFF_BYTES
  MAX_DIFF_BYTES="$(parse_positive_int "${LGAICM_MAX_DIFF_BYTES:-}" 200000)"

  local SUGGESTION_MIN
  SUGGESTION_MIN="$(parse_positive_int "${LGAICM_MIN_SUGGESTIONS:-}" 5)"
  local SUGGESTION_MAX
  SUGGESTION_MAX="$(parse_positive_int "${LGAICM_MAX_SUGGESTIONS:-}" 7)"

  local MAX_SUBJECT_LENGTH
  MAX_SUBJECT_LENGTH="$(parse_positive_int "${LGAICM_MAX_SUBJECT_LENGTH:-}" 500)"

  if (( SUGGESTION_MIN > SUGGESTION_MAX )); then
    SUGGESTION_MIN="$SUGGESTION_MAX"
  fi

  local DIFF_STAT DIFF_PATCH
  DIFF_STAT="$(git diff --cached --stat)"
  DIFF_PATCH="$(git diff --cached)"

  log_debug "Diff stat length: $(printf '%s' "$DIFF_STAT" | wc -c | awk '{print $1}') bytes"
  log_debug "Diff patch length: $(printf '%s' "$DIFF_PATCH" | wc -c | awk '{print $1}') bytes"

  DIFF_STAT="$(truncate_bytes "$DIFF_STAT" "$MAX_STAT_BYTES")"
  DIFF_PATCH="$(truncate_bytes "$DIFF_PATCH" "$MAX_DIFF_BYTES")"

  local PROMPT
  PROMPT="$(
    build_prompt \
      "$TYPE" \
      "$SUGGESTION_MIN" \
      "$SUGGESTION_MAX" \
      "$MAX_SUBJECT_LENGTH" \
      "$DIFF_STAT" \
      "$DIFF_PATCH"
  )"

  local RAW_OUTPUT
  RAW_OUTPUT="$(call_gemini_api "$API_URL" "$MODEL" "$CURL_TIMEOUT" "$PROMPT")"

  local PARSED_JSON
  PARSED_JSON="$(parse_suggestions_json "$RAW_OUTPUT")"

  write_suggestions "$TYPE" "$MAX_SUBJECT_LENGTH" "$PARSED_JSON"

  log_debug "=== Suggest command completed ==="
}

commit_cmd() {
  local FILE=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--file) FILE="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown argument for 'commit': $1" ;;
    esac
  done

  log_debug "=== Starting commit command ==="
  log_debug "File: $FILE"

  [[ -n "$FILE" ]] || die "'commit' requires --file <path>."
  [[ -f "$FILE" ]] || die "Commit message file does not exist: $FILE"

  require_command git
  git_require_repo

  log_debug_multiline "COMMIT MESSAGE CONTENT" "$(cat "$FILE")"

  git commit -F "$FILE"

  local dir
  dir="$(cd "$(dirname "$FILE")" && pwd -P)"
  if [[ -f "$dir/.lgaicm_session" ]]; then
    log_debug "Cleaning up session directory: $dir"
    rm -rf "$dir"
  fi

  log_debug "=== Commit command completed ==="
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  case "$1" in
    suggest) shift; suggest_cmd "$@" ;;
    commit) shift; commit_cmd "$@" ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown subcommand: $1 (use --help)" ;;
  esac
}

main "$@"

